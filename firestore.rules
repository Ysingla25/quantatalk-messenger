rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null || (request.auth == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastSeen']));
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}